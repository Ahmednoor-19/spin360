# --- storage / db ---
SPIN360_DATA_DIR=./data
SPIN360_DB_URL=sqlite:///./data/spin360.db

# --- queue ---
SPIN360_REDIS_URL=redis://localhost:6379/0
SPIN360_INLINE=0                             

# --- reconstruction provider ---
SPIN360_RECON_PROVIDER=mock
FAL_KEY=                       

# --- isolation ---  rembg | sam2 | auto
SPIN360_ISOLATION=auto

# --- render ---  blender (production) | cpu (fallback, no GPU)
SPIN360_RENDER=blender
SPIN360_BLENDER_BIN=blender
SPIN360_BLENDER_ENGINE=CYCLES      
SPIN360_BLENDER_SAMPLES=32

# --- quality gate ---
SPIN360_DETECT_MIN=0.60
SPIN360_QUALITY_MIN=0.55

# --- economics / guards ---
SPIN360_JOB_BUDGET=0.30
SPIN360_DAILY_BUDGET=50.0

# --- reliability ---
SPIN360_MAX_RETRIES=2
SPIN360_STAGE_TIMEOUT=600

# --- retention ---
SPIN360_RETENTION_H=72
